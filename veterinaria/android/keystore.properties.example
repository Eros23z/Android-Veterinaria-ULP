# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE FIRMA PARA DISTRIBUCIÓN (ANDROID RELEASE)
# ==============================================================================
# 1. Copia este archivo con el nombre "keystore.properties" en esta misma carpeta:
#    veterinaria/android/keystore.properties
# 2. Genera tu almacén de claves (Keystore) ejecutando:
#    keytool -genkey -v -keystore release-key.jks -alias veterinaria -keyalg RSA -keysize 2048 -validity 10000
#    (Nota: keytool se encuentra habitualmente en el directorio bin del JDK de Android Studio)
# 3. Coloca el archivo release-key.jks generado en:
#    veterinaria/android/app/release-key.jks
# 4. Completa las credenciales a continuación y NUNCA subas keystore.properties al control de versiones.
# ==============================================================================

storeFile=release-key.jks
storePassword=tu_password_del_almacen
keyAlias=veterinaria
keyPassword=tu_password_de_la_clave
